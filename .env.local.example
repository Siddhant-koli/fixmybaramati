# Database
# Example: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fixmybaramati?schema=public"

# Public app URL used by the application and external links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob read/write token for real report photo uploads.
# Required when uploading images to the configured storage provider.
BLOB_READ_WRITE_TOKEN="your_vercel_blob_read_write_token"

# Maximum uploaded image size in bytes. Default is 5 MB.
UPLOAD_MAX_BYTES="5242880"

# Environment
NODE_ENV="development"